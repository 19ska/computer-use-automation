# Copy to .env and fill in.

# Which LLM provider the Milestone 4 discovery loop (`cua discover`)
# uses. Not used by Milestone 3's deterministic replay (`cua replay`),
# which makes zero LLM calls. Supported values: gemini, groq. Defaults
# to gemini if unset. An unsupported value fails cleanly before
# discovery starts.
LLM_PROVIDER=groq

# --- Gemini (used when LLM_PROVIDER=gemini) ---
# Never logged, never written to discovery_output/ or any result object.
# Read once inside cua.discovery.llm.gemini_provider.
GEMINI_API_KEY=

# Which Gemini model the discovery loop uses. Isolated as configuration —
# never assumed permanently valid. Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-3.7-flash

# Optional: bounded retry policy for transient Gemini provider failures
# (503 "high demand") inside GeminiProvider only. Both optional — sensible
# defaults (3 attempts, 5s base with exponential backoff: 5s, 10s) apply
# if unset. Never affects non-transient errors (400, auth, etc.).
GEMINI_MAX_TRANSIENT_ATTEMPTS=3
GEMINI_RETRY_BASE_SECONDS=5

# --- Groq (used when LLM_PROVIDER=groq) ---
# Never logged, never written to discovery_output/ or any result object.
# Read once inside cua.discovery.llm.groq_provider.
GROQ_API_KEY=

# Which Groq model the discovery loop uses. Isolated as configuration —
# never assumed permanently valid.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: the groq SDK's own bounded internal retry count for transient
# (429/5xx/connection) failures at the HTTP layer. Defaults to 2 if unset.
GROQ_MAX_RETRIES=2

# Target application base URL.
PARABANK_BASE_URL=https://parabank.parasoft.com/parabank

# Credentials for the "parabank_demo" auth_profile referenced by
# session_requirement in examples/capabilities/parabank_transfer_funds.json.
# Use ONE dedicated, persistent synthetic ParaBank test account (not a
# fresh one per run). These values must never be committed, logged, or
# written into any artifact, screenshot, or replay result.
PARABANK_USERNAME=
PARABANK_PASSWORD=
